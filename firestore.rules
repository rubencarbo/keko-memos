rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function yoUid() { return request.auth.uid; }
    // Rubén: el único que puede invitar a familias nuevas
    function esSuper() { return conSesion() && request.auth.token.email == 'rubencarbo@gmail.com' && request.auth.token.email_verified == true; }

    // Invitaciones para crear familias nuevas
    match /invitaciones/{inv} {
      allow get: if conSesion();
      allow list: if esSuper();
      allow create, delete: if esSuper();
      // usar la invitación: solo una vez, a la vez que se crea la familia de quien la usa
      allow update: if conSesion() && resource.data.usada == false && request.resource.data.usada == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usada', 'hogarId', 'familia', 'usadaPor', 'usadaEmail', 'usadaMs'])
        && request.resource.data.usadaPor == yoUid()
        && getAfter(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.admin == yoUid()
        && getAfter(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.invitacion == inv;
    }

    // Índice usuario → hogar
    match /usuarios/{uid} {
      allow read, write: if conSesion() && yoUid() == uid;
    }

    // Códigos familiares: se pueden consultar uno a uno, no listar
    match /codigos/{codigo} {
      allow get: if conSesion();
      allow create: if conSesion()
        && getAfter(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.codigo == codigo
        && getAfter(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.admin == yoUid();
    }

    match /hogares/{hogar} {
      function rutaYo() { return /databases/$(database)/documents/hogares/$(hogar)/miembros/$(yoUid()); }
      function esMiembro() { return conSesion() && exists(rutaYo()); }
      function esAdulto() { return esMiembro() && get(rutaYo()).data.rol == 'adulto'; }
      function esAdmin() { return conSesion() && get(/databases/$(database)/documents/hogares/$(hogar)).data.admin == yoUid(); }

      allow read: if esMiembro();
      // Crear una familia: Rubén, o quien tenga una invitación sin usar (que se marca como usada en el mismo paso)
      allow create: if conSesion() && request.resource.data.admin == yoUid()
        && (esSuper()
            || (request.resource.data.invitacion is string
                && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacion)).data.usada == false
                && getAfter(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacion)).data.hogarId == hogar));
      // El titular de la cuenta del hogar solo puede pasar a otro adulto del hogar (al fusionar duplicados)
      allow update: if esAdulto()
        && request.resource.data.codigo == resource.data.codigo
        && (request.resource.data.admin == resource.data.admin
            || getAfter(/databases/$(database)/documents/hogares/$(hogar)/miembros/$(request.resource.data.admin)).data.rol == 'adulto');

      match /miembros/{uid} {
        allow read: if esMiembro();
        // Unirse: solo uno mismo y conociendo el código del hogar
        allow create: if conSesion() && yoUid() == uid
          && request.resource.data.codigo == getAfter(/databases/$(database)/documents/hogares/$(hogar)).data.codigo;
        // Cada uno edita su perfil (sin cambiarse el rol); los adultos pueden editar a todos
        // (los menores no pueden tocarse lo que se gana o se gasta en las misiones)
        allow update: if esAdulto()
          || (yoUid() == uid && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['rol', 'codigo', 'gastado', 'contador', 'logros', 'racha', 'estrellas', 'perfectos', 'perfectoDia']));
        // Borrar (o fusionar duplicados): administrador, cualquier adulto o uno mismo; nunca al administrador
        allow delete: if (esAdulto() || yoUid() == uid)
          && uid != getAfter(/databases/$(database)/documents/hogares/$(hogar)).data.admin;
      }

      match /recetas/{id} {
        allow read: if esMiembro();
        allow write: if esAdulto();
      }
      match /menus/{id} {
        allow read: if esMiembro();
        allow write: if esAdulto();
      }
      // Lista de la compra: todos añaden y marcan; solo los adultos borran
      match /despensa/{id} {
        allow read, create, update: if esMiembro();
        allow delete: if esAdulto();
      }
      match /avisos/{id} {
        allow read: if esMiembro();
        allow create: if esMiembro() && request.resource.data.de == yoUid();
        allow update: if esMiembro();
        allow delete: if esAdulto();
      }
      match /tareas/{id} {
        allow read: if esMiembro();
        // un menor solo puede apuntar tareas «pendientes» (las verifica un adulto)
        allow create: if esMiembro() && request.resource.data.por == yoUid()
          && (esAdulto() || request.resource.data.estado == 'pendiente');
        // verificar (o rechazar) una tarea: solo adultos; el menor solo marca como hecha su misión encargada
        allow update: if esAdulto()
          || (resource.data.uid == yoUid() && resource.data.estado == 'asignada' && request.resource.data.estado == 'pendiente'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'hechoMs']));
        allow delete: if esAdulto();
      }
      // Tienda de premios: cada uno pide su premio; solo un adulto lo entrega (y descuenta las estrellas)
      match /canjes/{id} {
        allow read: if esMiembro();
        allow create: if esMiembro() && request.resource.data.por == yoUid() && request.resource.data.estado == 'pendiente'
          && (esAdulto() || request.resource.data.uid == yoUid());
        allow update, delete: if esAdulto();
      }
    }
  }
}
